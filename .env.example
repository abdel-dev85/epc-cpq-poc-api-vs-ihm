# Configuration partagee par mcp-api/ et mcp-ihm/. Copier en `.env` a la racine.
# Le `.env` n'est pas versionne. Aucune de ces variables ne doit contenir de
# secret : le CLI Salesforce detient le jeton, pas ce fichier.
#
# Cible : le trial "Energy & Utilities Cloud Free Trial - Managed Package Apps".
# Voir docs/decisions.md pour pourquoi cet org et pas canopee-edf.

# --- Org Salesforce ----------------------------------------------------------

# Alias de l'org dans le CLI Salesforce, tel que liste par `sf org list`.
# Authentifier une fois : sf org login web --alias <alias>
SF_CLI_ORG=eu-cloud-trial

# Nom logique, repris tel quel dans les reponses d'outil.
SF_ALIAS=eu-cloud-trial

# Racine Lightning de l'org trial. Se lit avec :
#   sf org display --target-org eu-cloud-trial --json
# puis en remplacant .my.salesforce.com par .lightning.force.com dans
# instanceUrl. A ajuster une fois l'org cree : chaque trial a son propre
# sous-domaine Mon Domaine, genere a la creation.
SF_BASE_URL=https://CHANGEME.lightning.force.com

# Version d'API REST utilisee par mcp-api/. v62.0 ou plus recent correspond aux
# releases 2026 ; ajuster si le trial expose une version differente.
# Nom distinct expres de SF_API_VERSION : cette derniere est reservee au CLI
# Salesforce lui-meme (format sans "v"), les confondre fait echouer sf org display.
EPC_API_VERSION=v62.0

# --- CLI Salesforce ------------------------------------------------------------

# Binaire et dossier du CLI, si `sf` n'est pas dans le PATH herite. Un serveur
# MCP stdio herite d'un environnement pauvre : c'est un cas reel.
#SF_CLI_BIN=sf
#SF_CLI_DIR=
#SF_CLI_TIMEOUT=120000

# --- Reseau EDF ----------------------------------------------------------------

# Proxy pour joindre Salesforce depuis le poste EDF.
EDF_PROXY=http://vip-users.proxy.edf.fr:3131

# --- Comportement des serveurs ---------------------------------------------------

# Journal de debug dans debug.log (un fichier par serveur). Indispensable au
# diagnostic : un serveur stdio ne peut rien ecrire sur stdout.
#EPC_DEBUG=1

# mcp-ihm/ uniquement : 0 pour voir le navigateur pendant la mise au point des
# selecteurs (Regle 2 du CLAUDE.md de ce depot : un selecteur se derive d'une
# capture reelle, jamais d'une supposition).
#EPC_HEADLESS=0

#EPC_IDLE_TIMEOUT=600000
#EPC_NAV_TIMEOUT=60000
